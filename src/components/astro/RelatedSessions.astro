---
import { relatedSessions } from "@/lib/related-sessions";
import {
  formatWritten,
  postToneStyle,
  resolveTone,
  sessionId,
  TONES,
  type Tone,
} from "@/lib/session";
import type { SanitySessionTape } from "@/lib/sanity/types";
import { sessionLinkAttributes } from "@/lib/session-link";
import Cover from "./Cover.astro";

interface Props {
  session: SanitySessionTape;
  sessions: SanitySessionTape[];
  toneShift: number;
}
const { session, sessions, toneShift } = Astro.props;
const related = relatedSessions(session, sessions);
const forcedTone = TONES.includes(Astro.url.searchParams.get("tone") as Tone);
---

{related.length > 0 && (
  <section class="related-sessions" aria-labelledby="related-heading">
    <header class="related-sessions__heading">
      <div>
        <span class="mono">[04] Related</span>
        <h2 id="related-heading">Read next.</h2>
      </div>
      <span class="related-sessions__note mono">picked by hand, tags fill the gaps</span>
    </header>
    <div class="related-sessions__grid">
      {related.map(({ session: item, reason }) => {
        const tone = resolveTone(item.number, toneShift, Astro.url.searchParams, item.toneOverride);
        return (
          <a
            class="related-card"
            href={`/sessions/${item.slug}`}
            {...sessionLinkAttributes(item, tone)}
            style={postToneStyle(item.number, tone, forcedTone || Boolean(item.toneOverride))}
          >
            <div class="related-card__bar mono">
              <span>
                <span class="related-card__kind">
                  {item.kind === "tape" ? "Tape " : "Session "}
                </span>
                {sessionId(item.number)}
                <span class="related-card__mobile-read"> · {item.readTime} min</span>
              </span>
              <span
                class:list={[
                  "related-card__reason",
                  { "related-card__reason--picked": reason.kind === "picked" },
                ]}
              >
                {reason.kind === "picked" ? "Picked" : `Tag · ${reason.tag}`}
              </span>
            </div>
            <Cover
              seed={item.coverSeed}
              tone="--post-tone"
              animated={item.kind === "tape"}
              class="related-card__cover"
            />
            <div class="related-card__copy">
              <h3>{item.title}</h3>
              <span class="related-card__meta mono">
                ◷ {item.readTime} min ·{" "}
                <time datetime={item.date}>{formatWritten(item.date, true)}</time>
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </section>
)}

<style>
  .related-sessions {
    position: relative;
    padding: 8px 0 120px;
  }
  .related-sessions__heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding-bottom: 18px;
  }
  .related-sessions__heading > div {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }
  .related-sessions__heading .mono {
    font-size: 12px;
  }
  .related-sessions__heading h2 {
    margin: 0;
    font-size: 44px;
    font-weight: 500;
    letter-spacing: -0.04em;
  }
  .related-sessions__note {
    color: var(--mute);
  }
  .related-sessions__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 24px;
  }
  .related-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border: 1px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
  }
  .related-card:is(:hover, :focus-visible) {
    box-shadow: 4px 4px 0 var(--ink);
  }
  .related-card__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    padding: 6px 6px 6px 12px;
    border-bottom: 1px solid var(--ink);
    background: var(--post-tone);
    font-size: 11px;
  }
  .related-card__reason {
    flex-shrink: 0;
    border: 1px solid var(--ink);
    padding: 2px 8px;
    background: var(--paper);
    color: var(--ink);
  }
  .related-card__reason--picked {
    background: var(--ink);
    color: var(--paper);
  }
  .related-card :global(.related-card__cover) {
    width: 100%;
    aspect-ratio: 21 / 9;
  }
  .related-card__copy {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 8px;
    padding: 14px 14px 16px;
    border-top: 1px solid var(--ink);
  }
  .related-card h3 {
    margin: 0;
    font-size: 22px;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }
  .related-card__meta {
    margin-top: auto;
    font-size: 11px;
    color: var(--mute);
  }
  .related-card__mobile-read {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(:root:not([data-pref-motion="still"])) .related-card {
      transition:
        transform 150ms,
        box-shadow 150ms;
    }
    :global(:root:not([data-pref-motion="still"])) .related-card:is(:hover, :focus-visible) {
      transform: translateY(-3px);
    }
  }
  @media (max-width: 720px) {
    .related-sessions {
      padding-bottom: 52px;
    }
    .related-sessions__heading > div {
      flex-direction: column;
      gap: 8px;
    }
    .related-sessions__heading h2 {
      font-size: 30px;
    }
    .related-sessions__heading .mono {
      font-size: 11px;
    }
    .related-sessions__note,
    .related-card__kind,
    .related-card__meta {
      display: none;
    }
    .related-sessions__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }
    .related-card {
      display: grid;
      grid-template-columns: 56px minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      gap: 5px 12px;
      padding: 12px;
      background: color-mix(in srgb, var(--post-tone) 15%, var(--paper));
    }
    .related-card :global(.related-card__cover) {
      grid-column: 1;
      grid-row: 1 / 3;
      width: 56px;
      height: 56px;
      aspect-ratio: 1;
      border: 1px solid var(--ink);
    }
    .related-card__bar {
      grid-column: 2;
      grid-row: 1;
      padding: 0;
      border: 0;
      background: transparent;
      font-size: 10px;
    }
    .related-card__reason {
      padding: 1px 6px;
    }
    .related-card__mobile-read {
      display: inline;
    }
    .related-card__copy {
      grid-column: 2;
      grid-row: 2;
      padding: 0;
      border: 0;
    }
    .related-card h3 {
      font-size: 17px;
      line-height: 1.18;
      letter-spacing: -0.02em;
    }
  }
</style>
