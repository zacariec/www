---
import Cover from "./Cover.astro";
import Chip from "./Chip.astro";
import { formatWritten, postToneStyle } from "@/lib/session";
import { sessionLinkAttributes } from "@/lib/session-link";
import type { SanitySessionTape } from "@/lib/sanity/types";
interface Props {
  session: SanitySessionTape;
  tone: string;
}
const { session, tone } = Astro.props;
---

<a
  class="session-card"
  href={`/sessions/${session.slug}`}
  {...sessionLinkAttributes(session, tone)}
  style={postToneStyle(session.number, tone, Boolean(session.toneOverride))}
>
  <div class="card-bar mono">
    <span>{session.kind === "tape" ? "Tape" : "Session"}</span>
    <Chip kind="id" number={session.number} tone={tone} />
    <span class="card-read">
      <Chip minutes={session.readTime} />
    </span>
  </div>
  <Cover
    seed={session.coverSeed}
    tone="--post-tone"
    animated={session.kind === "tape"}
    class="card-cover"
  />
  <div class="card-copy">
    <h3>{session.title}</h3>
    <p>{session.subtitle}</p>
    <time class="mono" datetime={session.date}>
      Written {formatWritten(session.date, true)}
    </time>
  </div>
</a>
<style>
  .session-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--ink);
    background: var(--paper);
    min-width: 0;
    transition:
      transform 150ms,
      box-shadow 150ms;
  }
  .session-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 5px 5px 0 var(--ink);
  }
  .card-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--post-tone);
    padding: 10px 12px;
    border-bottom: 1px solid var(--ink);
  }
  .card-read {
    margin-left: auto;
  }
  .card-cover {
    aspect-ratio: 16/9;
  }
  .card-copy {
    padding: 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
    border-top: 1px solid var(--ink);
  }
  h3 {
    font-size: 30px;
    line-height: 1.08;
    letter-spacing: -0.04em;
    font-weight: 500;
    margin: 0 0 14px;
  }
  p {
    font-size: 16px;
    line-height: 1.55;
    color: var(--mute);
    margin: 0 0 24px;
  }
  time {
    color: var(--mute);
    margin-top: auto;
  }
  @media (max-width: 720px) {
    .card-copy {
      padding: 20px;
    }
    h3 {
      font-size: 29px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .session-card {
      transition: none;
    }
  }
</style>
