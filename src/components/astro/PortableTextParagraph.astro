---
import type { Block, Props as PortableTextProps } from "astro-portabletext/types";
import ParagraphAnchor from "./ParagraphAnchor.astro";
type Props = PortableTextProps<Block & { _zcParagraph?: number; _zcReplies?: number }>;
const { node } = Astro.props;
---

{node._zcParagraph ? (
  <div
    class="article-paragraph"
    id={`p${node._zcParagraph}`}
    data-paragraph={node._zcParagraph}
    tabindex="-1"
  >
    <ParagraphAnchor index={node._zcParagraph} replies={node._zcReplies} />
    <p class="article-paragraph__text">
      <slot />
    </p>
  </div>
) : (
  <p>
    <slot />
  </p>
)}
