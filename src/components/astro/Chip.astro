---
import { TONES, sessionId } from "@/lib/session";
import { rollId } from "@/lib/roll";
interface Props {
  kind?: "read" | "id" | "frames";
  frames?: number;
  postKind?: "session" | "tape" | "roll";
  minutes?: number;
  number?: number;
  tone?: string;
  class?: string;
}

const {
  kind = "read",
  minutes = 0,
  frames = 0,
  postKind = "session",
  number = 0,
  tone = "sand",
  class: className,
  ...rest
} = Astro.props;
const color = TONES.find((value) => value === tone) ?? "sand";
const id = postKind === "roll" ? rollId(number) : sessionId(number);
---

<span
  {...rest}
  class:list={["zc-chip", `zc-chip--${kind}`, "mono", className]}
  style={kind === "id" ? `--chip-tone: var(--post-tone,var(--${color}))` : undefined}
  aria-label={kind === "read" ? `${minutes} minute read` : kind === "frames" ? `${frames} frames` : `${postKind === "roll" ? "Roll" : "Session"} ${number}`}
>
  {kind === "read" ? (
    <>
      <span aria-hidden="true">◷</span> {minutes} MIN
    </>
  ) : kind === "frames" ? (
    <><span aria-hidden="true">▦</span> {frames} FRAMES</>
  ) : (
    id
  )}
</span>

<style>
  .zc-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    width: max-content;
    padding: 3px 8px;
    font-size: 11px;
    line-height: 1.4;
    white-space: nowrap;
  }

  .zc-chip--read,
  .zc-chip--frames {
    background: var(--ink);
    color: var(--paper);
  }

  .zc-chip--id {
    border: 1px solid var(--ink);
    background: var(--chip-tone);
    color: var(--ink);
  }
</style>
