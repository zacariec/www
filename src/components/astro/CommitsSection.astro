---
import { formatDistanceToNow } from "date-fns";
import { getGitHubSnapshot, type ContributionDay } from "@/lib/github";
import { postToneStyle, resolveTone, sessionId, TONES, type Tone } from "@/lib/session";
import type { SanitySessionTape } from "@/lib/sanity/types";
import SectionHead from "./SectionHead.astro";

interface Props {
  sessions: SanitySessionTape[];
  toneShift: number;
}

const { sessions, toneShift } = Astro.props;
const github = getGitHubSnapshot();
const latest = sessions[0];
const params = new URLSearchParams(Astro.url.search);
const forcedTone = TONES.includes(params.get("tone") as Tone);
const tone = resolveTone(latest?.number ?? 1, toneShift, params, latest?.toneOverride);
const toneStyle = postToneStyle(
  latest?.number ?? 1,
  tone,
  forcedTone || Boolean(latest?.toneOverride),
);
const sessionsByDay = new Map<string, string[]>();
for (const session of sessions) {
  const day = session.date.slice(0, 10);
  const ids = sessionsByDay.get(day) ?? [];
  ids.push(sessionId(session.number));
  sessionsByDay.set(day, ids);
}
const days =
  github?.days.map((day) => ({
    ...day,
    ...(!day.future && sessionsByDay.has(day.iso)
      ? { sessionIds: sessionsByDay.get(day.iso) }
      : {}),
  })) ?? [];
const daysJson = JSON.stringify(days);
const monthFormatter = new Intl.DateTimeFormat("en", { month: "short", timeZone: "UTC" });
function monthLabels(calendar: ContributionDay[], weeks: number) {
  const visible = calendar.slice(-weeks * 7);
  const labels: { label: string; left: number }[] = [];
  let previous = "";
  for (let week = 0; week < weeks; week++) {
    const day = visible[week * 7];
    if (!day) continue;
    const month = day.iso.slice(0, 7);
    if (month === previous) continue;
    previous = month;
    const left = week * 15;
    if (left > weeks * 15 - 30) continue;
    if (labels.length && left - labels[labels.length - 1].left < 30) labels.pop();
    labels.push({ label: monthFormatter.format(new Date(`${day.iso}T00:00:00Z`)), left });
  }
  return labels;
}
const lastPush = github?.lastPush;
const lastCommit = lastPush?.commits[0];
const timelineParams = new URLSearchParams(Astro.url.search);
timelineParams.set("filter", "pushes");
const timelineHref = `/timeline?${timelineParams}`;
---

<section class="commits-section zc-container" aria-label="Commits" style={toneStyle} data-commits>
  <div class="commits-heading">
    <SectionHead number="02" title="Commits" />
    {github && (
      <a
        class="mono"
        href={`https://github.com/${github.login}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        gh/{github.login} ↗
      </a>
    )}
  </div>
  {github ? (
    <div class="commits-window mono">
      <div class="commits-calendar">
        <div class="commits-title">
          <span class="desktop-only">$ git log --author={github.login} --since=1.year</span>
          <span class="mobile-only">git log · 22 weeks</span>
          <span class="commits-total">
            {github.total.toLocaleString("en-GB")} contributions
            <span class="mobile-only"> / year</span>
          </span>
        </div>
        {[53, 22].map((weeks) => (
          <div class:list={["heat-scroll", weeks === 53 ? "desktop-only" : "mobile-only"]}>
            <div class:list={["heat-grid", { "heat-grid--mobile": weeks === 22 }]}>
              {weeks === 53 && <span aria-hidden="true" />}
              <div class="heat-months" aria-hidden="true">
                {monthLabels(days, weeks).map((month) => (
                  <span style={`left:${month.left}px`}>{month.label}</span>
                ))}
              </div>
              {weeks === 53 && (
                <div class="heat-weekdays" aria-hidden="true">
                  <span style="top:13px">Mon</span>
                  <span style="top:43px">Wed</span>
                  <span style="top:73px">Fri</span>
                </div>
              )}
              <canvas
                data-zc="heat"
                data-days={daysJson}
                data-weeks={weeks}
                data-fg="--post-tone"
                width={weeks === 53 ? 792 : 327}
                height="102"
                tabindex="0"
                aria-label={`${github.login}'s public GitHub contributions over ${weeks} weeks. Use arrow keys to explore days; Home and End move to the first and last day.`}
                aria-describedby="contribution-readout"
              >
                {github.total.toLocaleString("en-GB")} public contributions in the past year.
                Current streak: {github.currentStreak} days.
              </canvas>
            </div>
          </div>
        ))}
        <div class="heat-details">
          <p
            id="contribution-readout"
            class="heat-readout"
            data-heat-readout
            role="status"
            aria-live="polite"
            aria-atomic="true"
          >
            <span class="desktop-only">Hover a day.</span>
            <span class="mobile-only">Tap a day.</span>
          </p>
          <div
            class="heat-legend"
            aria-label="Contribution intensity from less to more; a central square marks a published session."
          >
            <span>less</span>
            <canvas
              data-zc="heat"
              data-legend="true"
              data-fg="--post-tone"
              width="72"
              height="12"
              aria-hidden="true"
            />
            <span>more</span>
            <span class="heat-session-legend">
              <canvas
                data-zc="heat"
                data-legend="mark"
                data-fg="--post-tone"
                width="12"
                height="12"
                aria-hidden="true"
              />
              session published
            </span>
          </div>
        </div>
      </div>
      <div class="commits-summary">
        <div class="commits-stats">
          <div class="streak-cell">
            <span class="stat-label">CURRENT STREAK</span>
            <strong>{github.currentStreak}d</strong>
            <span class="stat-label">longest {github.longestStreak}d</span>
          </div>
          <div class="push-cell">
            <span class="stat-label">
              LAST PUSH
              {lastPush && (
                <>
                  {" "}
                  ·{" "}
                  <time datetime={lastPush.date}>
                    {formatDistanceToNow(new Date(lastPush.date), { addSuffix: true })}
                  </time>
                </>
              )}
            </span>
            {lastPush ? (
              <>
                <a
                  class="last-push-repo"
                  href={
                    lastPush.comparisonUnavailable
                      ? `https://github.com/${lastPush.repo}`
                      : lastPush.compareUrl
                  }
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {lastPush.repo}
                </a>
                {lastPush.comparisonUnavailable ? (
                  <p class="last-push-message">Commit details unavailable.</p>
                ) : (
                  lastCommit && (
                    <p class="last-push-message">
                      <span>{lastCommit.sha.slice(0, 7)}</span> {lastCommit.message}
                    </p>
                  )
                )}
              </>
            ) : (
              <p>No recent public pushes.</p>
            )}
          </div>
        </div>
        <a class="commits-timeline" href={timelineHref}>
          <span>git log in timeline</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  ) : (
    <div class="commits-unavailable mono">Public GitHub activity is currently unavailable.</div>
  )}
</section>

<script>
  import "@/scripts/commits";
</script>

<style>
  .commits-section {
    position: relative;
    z-index: 2;
    padding-bottom: 128px;
  }
  .commits-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }
  .commits-heading > a {
    flex-shrink: 0;
  }
  .commits-window {
    display: flex;
    flex-wrap: wrap;
    min-width: 0;
    border: 1px solid var(--ink);
    background: var(--paper);
    box-shadow: 8px 8px 0 var(--ink);
    font-size: 12px;
  }
  .commits-calendar {
    flex: 4 1 640px;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .commits-title {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 12px;
    border-bottom: 1px solid var(--ink);
    font-size: 11px;
  }
  .commits-total {
    color: var(--mute);
  }
  .heat-scroll {
    overflow-x: auto;
    padding: 18px 16px 12px;
    overscroll-behavior-x: contain;
  }
  .heat-grid {
    display: grid;
    grid-template-columns: 34px 792px;
    grid-template-rows: 18px 102px;
    width: 826px;
    margin-inline: auto;
  }
  .heat-months,
  .heat-weekdays {
    position: relative;
    color: var(--mute);
    font-size: 10px;
  }
  .heat-months > span,
  .heat-weekdays > span {
    position: absolute;
  }
  .heat-grid canvas {
    display: block;
    width: 792px;
    height: 102px;
    max-width: none;
    image-rendering: pixelated;
    cursor: crosshair;
  }
  .heat-details {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 10px 20px;
    padding: 10px 12px;
    border-top: 1px solid var(--rule);
    margin-top: auto;
  }
  .heat-readout {
    flex: 1 1 360px;
    height: 3em;
    overflow-y: auto;
    font-variant-numeric: tabular-nums;
  }
  .heat-legend,
  .heat-session-legend {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .heat-legend {
    flex-wrap: wrap;
    color: var(--mute);
    font-size: 11px;
  }
  .heat-session-legend {
    margin-left: 10px;
  }
  .heat-legend canvas {
    display: block;
    flex-shrink: 0;
    width: 72px;
    height: 12px;
    image-rendering: pixelated;
  }
  .heat-session-legend canvas {
    width: 12px;
  }
  .commits-summary {
    flex: 1 1 250px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    box-shadow: -1px -1px 0 var(--ink);
  }
  .commits-stats {
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .streak-cell,
  .push-cell {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px;
    min-width: 0;
  }
  .streak-cell {
    background: var(--ink);
    color: var(--paper);
  }
  .streak-cell strong {
    font: 500 40px/1 var(--font-host-grotesk);
    letter-spacing: -0.04em;
  }
  .stat-label {
    font-size: 11px;
    color: var(--mute);
  }
  .streak-cell .stat-label {
    color: var(--paper);
    opacity: 0.8;
  }
  .push-cell {
    flex: 1;
    gap: 8px;
  }
  .last-push-repo {
    font: 500 20px/1.15 var(--font-host-grotesk);
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
  .last-push-message {
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .last-push-message > span {
    color: var(--mute);
  }
  .commits-timeline {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 16px;
    border-top: 1px solid var(--ink);
  }
  .commits-unavailable {
    border: 1px solid var(--ink);
    padding: 24px;
    background: var(--paper);
    box-shadow: var(--hard-shadow);
  }
  .mobile-only {
    display: none;
  }
  @media (max-width: 720px) {
    .commits-section {
      padding-bottom: 100px;
    }
    .commits-window {
      display: block;
      box-shadow: 5px 5px 0 var(--ink);
      font-size: 11px;
    }
    .desktop-only {
      display: none;
    }
    .mobile-only {
      display: block;
    }
    .commits-total .mobile-only {
      display: inline;
    }
    .commits-title {
      padding: 7px 10px;
      gap: 4px;
      font-size: 10px;
    }
    .heat-scroll {
      padding: 14px 10px 10px;
    }
    .heat-grid--mobile {
      grid-template-columns: 327px;
      grid-template-rows: 16px 102px;
      width: 327px;
    }
    .heat-grid--mobile canvas {
      width: 327px;
    }
    .heat-details {
      gap: 8px;
      padding: 6px 10px 10px;
    }
    .heat-readout {
      flex-basis: 100%;
      min-height: 3em;
    }
    .heat-legend {
      font-size: 10px;
      gap: 6px;
    }
    .heat-session-legend {
      margin-left: 4px;
      gap: 6px;
    }
    .commits-summary {
      box-shadow: none;
      border-top: 1px solid var(--ink);
    }
    .commits-stats {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .streak-cell,
    .push-cell {
      padding: 10px 12px;
      gap: 4px;
    }
    .streak-cell strong {
      font-size: 30px;
    }
    .stat-label {
      font-size: 9px;
    }
    .last-push-repo {
      font-size: 17px;
    }
    .last-push-message {
      font-size: 10px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .commits-timeline {
      min-height: 44px;
      align-items: center;
      padding: 0 12px;
      font-size: 12px;
    }
  }
</style>
