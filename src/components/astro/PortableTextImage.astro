---
import { urlFor } from "@/lib/sanity/client";
import type { Props as PortableTextProps } from "astro-portabletext/types";
import type { SanityImageBlock } from "@/lib/sanity/types";

type ImageNode = SanityImageBlock & { _zcFigure?: string };
type Props = PortableTextProps<ImageNode>;

const { node } = Astro.props;

function hasAsset(
  image: ImageNode,
): image is ImageNode & { asset: NonNullable<SanityImageBlock["asset"]> } {
  return Boolean(image.asset?._ref);
}

// GIFs die if you touch the CDN's transform pipeline (auto-format converts
// to static WebP, resize keeps only the first frame). Serve the raw asset
// URL with no transform so animation survives. Everything else stays at
// width-1200 for responsive delivery.
let src = node.url;
if (hasAsset(node)) {
  const isGif = node.asset._ref.endsWith("-gif");
  src = isGif ? urlFor(node).url() : urlFor(node).width(1200).url();
}
---

<figure class="article-figure">
  {src && <img alt={node.alt ?? ""} src={src} loading="lazy" decoding="async" />}
  {(node.caption || node._zcFigure) && (
    <figcaption>
      {node._zcFigure}
      {node._zcFigure && node.caption ? " — " : ""}
      {node.caption}
    </figcaption>
  )}
</figure>
