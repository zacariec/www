---
import { PortableText } from "astro-portabletext";
import { Thread } from "@/components/organisms/thread";
import { normalizeMarkdownShortcuts } from "@/lib/sanity/normalize-markdown";
import {
  formatWritten,
  resolveTone,
  postToneStyle,
  sectionId,
  sessionId,
  TONES,
  type Tone,
} from "@/lib/session";
import { sessionNeighbors } from "@/lib/related-sessions";
import type { SanitySessionTape, SanitySiteConfig } from "@/lib/sanity/types";
import Blot from "./Blot.astro";
import Cortex from "./Cortex.astro";
import Cover from "./Cover.astro";
import Chip from "./Chip.astro";
import Window from "./Window.astro";
import GlyphDivider from "./GlyphDivider.astro";
import MetaStrip from "./MetaStrip.astro";
import ReadingPanel from "./ReadingPanel.astro";
import RelatedSessions from "./RelatedSessions.astro";
import OverlayScroll from "@/components/OverlayScroll.astro";
import "@/styles/reading.css";

// Dynamic imports keep Astro serializers out of Vite's JS dependency scanner.
const PortableTextImage = (await import("./PortableTextImage.astro")).default;
const PortableTextParagraph = (await import("./PortableTextParagraph.astro")).default;
const PortableTextCode = (await import("./PortableTextCode.astro")).default;
const PortableTextInlineCode = (await import("./PortableTextInlineCode.astro")).default;
const PortableTextH2 = (await import("./PortableTextH2.astro")).default;
const PortableTextH3 = (await import("./PortableTextH3.astro")).default;
const PortableTextH4 = (await import("./PortableTextH4.astro")).default;
const PortableTextBlockquote = (await import("./PortableTextBlockquote.astro")).default;

interface Props {
  session: SanitySessionTape;
  sessions: SanitySessionTape[];
  config: SanitySiteConfig;
}

const { session, sessions, config } = Astro.props;
const id = sessionId(session.number);
const tone = resolveTone(
  session.number,
  config.toneShift,
  Astro.url.searchParams,
  session.toneOverride,
);
const fixedTone =
  TONES.includes(Astro.url.searchParams.get("tone") as Tone) || Boolean(session.toneOverride);
const isTape = session.kind === "tape";
const comments = session.comments.filter((comment) => comment.status === "approved");
const { previous, next } = sessionNeighbors(session, sessions);
const sections = new Map(session.sections.map((section) => [section.key, section.id]));
let paragraphCount = 0;
let figureCount = session.featuredImage?.url ? 1 : 0;
const normalizedContent = normalizeMarkdownShortcuts(session.content).map((node, index) => {
  if (node._type === "block" && (!node.style || node.style === "normal") && !node.listItem) {
    const paragraphIndex = ++paragraphCount;
    return {
      ...node,
      _zcParagraph: paragraphIndex,
      _zcReplies: comments.filter((comment) => comment.anchorIndex === paragraphIndex).length,
    };
  }
  if (node._type === "block" && node.style === "h2") {
    const headingId =
      (node._key ? sections.get(node._key) : undefined) ?? sectionId(node._key, index);
    return { ...node, _zcHeading: headingId };
  }
  if (node._type === "image")
    return { ...node, _zcFigure: isTape ? `Fig ${id}.${++figureCount}` : undefined };
  return node;
});
const ptComponents = {
  type: { image: PortableTextImage, code: PortableTextCode },
  block: {
    normal: PortableTextParagraph,
    h2: PortableTextH2,
    h3: PortableTextH3,
    h4: PortableTextH4,
    blockquote: PortableTextBlockquote,
  },
  mark: { code: PortableTextInlineCode },
};
---

<div
  class="article-template"
  data-session-prev={previous ? `/sessions/${previous.slug}` : ""}
  data-session-next={next ? `/sessions/${next.slug}` : ""}
  data-reading-root
  data-slug={session.slug}
  data-read-time={session.readTime}
  data-paragraph-count={paragraphCount}
  style={postToneStyle(session.number, tone, fixedTone)}
>
  <div class="article-shell">
    <header class:list={["page-hero", "article-hero", { "article-hero--tape": isTape }]}>
      <Blot tone="--post-tone" seed={session.coverSeed + 33} class="article-hero__blot" />
      <Cortex
        sessions={sessions.map(({ number, readTime, kind }) => ({ number, readTime, kind }))}
        highlight={session.number - 1}
        class="article-hero__cortex"
        ox={0.76}
        scale={0.8}
        fade={0.85}
        fadeBottom={0.45}
        drift
      />
      <a class="article-back" href="/sessions" data-sessions-back>
        ← cd ../sessions
      </a>
      <h1>
        <span>{session.title}</span>
      </h1>
      <div class="article-hero__meta">
        {isTape ? (
          <>
            <span class="article-hero__id">Tape {id} · long-form</span>
            <span>{session.readTime} mins read</span>
            <span>{String(session.sections.length).padStart(2, "0")} sections</span>
          </>
        ) : (
          <>
            <span class="article-hero__id">{id}</span>
            <span>Written {formatWritten(session.date, true)}</span>
            <span>{session.readTime} min</span>
            <span>{session.state === "edited" ? "Edited" : "Raw · unedited"}</span>
            <span class="article-hero__node">Node lit in Fig 01</span>
          </>
        )}
        {session.writtenTo && (
          <a
            class="article-written-to"
            href={session.writtenTo.spotifyUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            ♪ written to {session.writtenTo.track} — {session.writtenTo.artist}
          </a>
        )}
      </div>
    </header>

    {isTape ? (
      <Window title={`Fig ${id} — cover, dithered`} class="tape-cover">
        <span slot="right">Written {formatWritten(session.date, true)}</span>
        <Cover seed={session.coverSeed} tone="--post-tone" animated class="tape-cover__canvas" />
      </Window>
    ) : (
      <MetaStrip session={session} tone={tone} fixedTone={fixedTone} />
    )}

    <section
      class:list={["reading-layout", { "reading-layout--tape": isTape }]}
      data-reading-article
      aria-label="Session article"
    >
      <ReadingPanel session={session} paragraphCount={paragraphCount} mobile />
      {isTape && session.sections.length > 0 && (
        <nav class="article-contents article-contents--mobile" aria-label="Contents">
          <Window title="Contents">
            <span slot="right">{session.sections.length} sections</span>
            <ol>
              {session.sections.map((section, index) => (
                <li>
                  <a href={`#${section.id}`}>
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    {section.title}
                  </a>
                </li>
              ))}
            </ol>
          </Window>
        </nav>
      )}
      <article class="article-body" data-reading-body>
        {session.subtitle && <p class="article-lede">{session.subtitle}</p>}
        {session.featuredImage?.url && (
          <figure class="article-figure">
            <img
              src={session.featuredImage.url}
              alt={session.featuredImage.alt || ""}
              loading="lazy"
              decoding="async"
            />
            {(isTape || session.featuredImage.alt) && (
              <figcaption>
                {isTape && `Fig ${id}.1`}
                {session.featuredImage.alt && `${isTape ? " — " : ""}${session.featuredImage.alt}`}
              </figcaption>
            )}
          </figure>
        )}
        <div class="article-prose">
          <PortableText value={normalizedContent} components={ptComponents} />
        </div>
        <div class="article-eof">
          <GlyphDivider />
        </div>
        <nav class="article-neighbors" aria-label="Previous and next sessions">
          <div class="article-neighbors__grid">
            {previous && (
              <a class="article-neighbor" href={`/sessions/${previous.slug}`}>
                <span class="article-neighbor__label">
                  <span>← Previous · {sessionId(previous.number)}</span>
                  <kbd aria-hidden="true">[</kbd>
                </span>
                <span class="article-neighbor__title">{previous.title}</span>
                <Chip kind="read" minutes={previous.readTime} />
              </a>
            )}
            {next ? (
              <a class="article-neighbor article-neighbor--next" href={`/sessions/${next.slug}`}>
                <span class="article-neighbor__label">
                  <kbd aria-hidden="true">]</kbd>
                  <span>Next · {sessionId(next.number)} →</span>
                </span>
                <span class="article-neighbor__title">{next.title}</span>
                <Chip kind="read" minutes={next.readTime} />
              </a>
            ) : (
              <div class="article-neighbor article-neighbor--next article-neighbor--unwritten">
                <span class="article-neighbor__label">Next · {sessionId(session.number + 1)}</span>
                <span class="article-neighbor__title">Still being written.</span>
                <a href="#updates">get it by email ↓</a>
              </div>
            )}
          </div>
          <p class="article-neighbors__hint">
            <kbd>[</kbd> and <kbd>]</kbd> step between sessions
          </p>
        </nav>
      </article>
      <aside class="reading-sidebar" aria-label="Reading tools">
        <div class="reading-sidebar__sticky">
          <OverlayScroll
            axis="y"
            label="Reading tools"
            role="region"
            class="reading-sidebar__scroll"
          >
            <div class="reading-sidebar__content">
              {isTape && session.sections.length > 0 && (
                <nav class="article-contents" aria-label="Contents">
                  <Window title="Contents">
                    <span slot="right">{session.sections.length} sections</span>
                    <ol>
                      {session.sections.map((section, index) => (
                        <li>
                          <a href={`#${section.id}`}>
                            <span>{String(index + 1).padStart(2, "0")}</span>
                            {section.title}
                          </a>
                        </li>
                      ))}
                    </ol>
                  </Window>
                </nav>
              )}
              <ReadingPanel session={session} paragraphCount={paragraphCount} />
            </div>
          </OverlayScroll>
        </div>
      </aside>
    </section>
    <RelatedSessions session={session} sessions={sessions} toneShift={config.toneShift} />
  </div>

  <dialog
    id="paragraph-dialog"
    class="paragraph-dialog"
    aria-labelledby="paragraph-dialog-title"
    data-paragraph-dialog
  >
    <OverlayScroll
      axis="y"
      tone="paper"
      class="paragraph-dialog__scroll"
      label="Paragraph actions"
      tabindex={-1}
    >
      <div>
        <div class="paragraph-dialog__title">
          <span id="paragraph-dialog-title">
            Anchor <span data-dialog-paragraph>¶01</span>
          </span>
          <button type="button" data-dialog-close aria-label="Close paragraph actions">
            ×
          </button>
        </div>
        <div class="paragraph-dialog__actions">
          <button type="button" data-highlight-toggle aria-pressed="false">
            □ Highlight <span data-dialog-paragraph>¶01</span>
          </button>
          <button type="button" data-comment-open>
            ↳ Comment on <span data-dialog-paragraph>¶01</span>
          </button>
          <button type="button" data-copy-anchor>
            ⧉ Copy link to <span data-dialog-paragraph>¶01</span>
          </button>
        </div>
        <form class="paragraph-dialog__composer" data-paragraph-composer hidden>
          <label for="paragraph-draft">
            Comment on <span data-dialog-paragraph>¶01</span>
          </label>
          <textarea
            id="paragraph-draft"
            name="body"
            rows="3"
            maxlength="5000"
            placeholder="Say the thing"
          ></textarea>
          <button type="submit" disabled>
            Post ↵
          </button>
        </form>
        <p class="paragraph-dialog__status" data-dialog-status role="status"></p>
      </div>
    </OverlayScroll>
  </dialog>

  <Thread
    client:visible
    sessionId={session._id}
    slug={session.slug}
    paragraphCount={paragraphCount}
    initialComments={comments}
  />
</div>

<script>
  import "@/scripts/reading";
</script>
