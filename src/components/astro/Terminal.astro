---
import { navigation } from "@/lib/navigation";
import OverlayScroll from "@/components/OverlayScroll.astro";
import { sessionId } from "@/lib/session";
import type { GitHubPush } from "@/lib/github";
import type { SanitySessionTape, SanitySiteConfig } from "@/lib/sanity/types";
import type { TerminalData } from "@/scripts/terminal";
interface Props {
  path: string;
  sessions: SanitySessionTape[];
  config: SanitySiteConfig;
  pushes: GitHubPush[];
}
const { path, sessions, config, pushes } = Astro.props;
const data: TerminalData = {
  pages: navigation.map(({ label, href }) => ({ label, href })),
  sessions: sessions.map((session) => ({
    id: sessionId(session.number),
    title: session.title,
    slug: session.slug,
  })),
  readme: config.readme,
  identity: config.author,
  pushes: pushes
    .slice(0, 5)
    .map(({ repo, date, branch, commits }) => ({ repo, date, branch, commits })),
};
---

<div class="terminal mono" data-terminal data-terminal-content={JSON.stringify(data)}>
  <div class="terminal-title">
    <span>zsh — zc@paper — 80×24</span>
    <span aria-hidden="true">∵ ⩆</span>
  </div>
  <OverlayScroll
    axis="y"
    tone="ink"
    class="terminal-scroll"
    data-terminal-scroll
    label="Terminal output"
  >
    <div class="terminal-content">
      <div
        class="terminal-output"
        data-terminal-output
        role="log"
        aria-label="Terminal output"
        aria-live="polite"
        aria-relevant="additions"
      >
        <div class="terminal-line">$ cd {path}</div>
        <div class="terminal-line terminal-line--error">cd: no such file or directory: {path}</div>
        <div class="terminal-line terminal-line--muted">Type help, or tap a command below.</div>
      </div>
      <form class="terminal-prompt" data-terminal-form>
        <label for="terminal-input">zc@paper ~/lost $</label>
        <input
          id="terminal-input"
          data-terminal-input
          aria-label="Terminal input"
          type="text"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          maxlength="1024"
          enterkeyhint="go"
        />
      </form>
    </div>
  </OverlayScroll>
  <OverlayScroll axis="x" tone="ink" class="terminal-chips" label="Terminal commands">
    <div class="terminal-chip-list">
      {["help", "ls", "cd sessions", "cat readme", "git log"].map((command) => (
        <button type="button" data-terminal-command={command}>
          {command}
        </button>
      ))}
    </div>
  </OverlayScroll>
</div>
<style>
  .terminal {
    --mute: var(--black-mute);
    --rule: var(--black-rule);
    position: relative;
    z-index: 1;
    max-width: 880px;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    box-shadow: 8px 8px 0 var(--pink);
    font-size: 13px;
    cursor: var(--cur-text, text);
  }
  .terminal-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 12px;
    border-bottom: 1px solid var(--rule);
    color: var(--mute);
    font-size: 11px;
  }
  .terminal-scroll {
    max-height: 380px;
    min-height: 260px;
    overflow-y: auto;
    padding: 14px 14px 4px;
    line-height: 1.6;
    overscroll-behavior: contain;
  }
  .terminal-output {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .terminal-output :global(.terminal-line) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .terminal-output :global(.terminal-line--error) {
    color: var(--pink);
  }
  .terminal-output :global(.terminal-line--muted) {
    color: var(--mute);
  }
  .terminal-output :global(.terminal-line--hint) {
    color: var(--blue);
  }
  .terminal-prompt {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 2px 0 12px;
  }
  .terminal-prompt label {
    color: var(--pink);
    white-space: nowrap;
  }
  .terminal-prompt input {
    flex: 1;
    min-width: 0;
    min-height: 32px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--paper);
    font: inherit;
    caret-color: var(--pink);
  }
  .terminal-prompt input:focus-visible {
    outline: 1px solid var(--pink);
    outline-offset: 2px;
  }
  .terminal-chips {
    overflow-x: auto;
    padding: 10px 12px;
    border-top: 1px solid var(--rule);
  }
  .terminal-chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .terminal-chips button {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid var(--mute);
    background: transparent;
    color: var(--paper);
    font: inherit;
    font-size: 12px;
  }
  .terminal-chips button:hover,
  .terminal-chips button:focus-visible {
    background: var(--paper);
    color: var(--ink);
  }
  @media (max-width: 720px) {
    .terminal {
      box-shadow: 5px 5px 0 var(--pink);
      font-size: 12px;
    }
    .terminal-scroll {
      min-height: 240px;
      max-height: 360px;
      padding-inline: 12px;
    }
    .terminal-prompt {
      gap: 8px;
    }
    .terminal-prompt input {
      min-height: 44px;
      font-size: 16px;
    }
    .terminal-chip-list {
      width: max-content;
      min-width: 100%;
      flex-wrap: nowrap;
    }
  }
</style>
<script>
  import "@/scripts/terminal";
</script>
