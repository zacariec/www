---
import Cover from "./Cover.astro";
import Chip from "./Chip.astro";
import { formatWritten, postToneStyle } from "@/lib/session";
import { sessionLinkAttributes } from "@/lib/session-link";
import type { SanityPost } from "@/lib/sanity/types";
import { postHref } from "@/lib/post";
import { rollImageUrl } from "@/lib/roll";
interface Props {
  session: SanityPost;
  tone: string;
}
const { session, tone } = Astro.props;
const frames = session.kind === "roll" ? session.groups.flatMap((group) => group.frames).slice(0, 4) : [];
---

<a
  class="session-row"
  href={postHref(session)}
  {...sessionLinkAttributes(session, tone)}
  style={postToneStyle(session.number, tone, Boolean(session.toneOverride))}
  data-session-kind={session.kind}
>
  <div class:list={["row-cover", { "row-cover--roll": session.kind === "roll" }]}>
    {session.kind === "roll" ? frames.map((frame, index) => (
      <Cover seed={session.coverSeed + index} tone="--post-tone" imageUrl={rollImageUrl(frame, 320, 1)} />
    )) : <Cover seed={session.coverSeed} tone="--post-tone" animated={session.kind === "tape"} />}
  </div>
  <div class="row-copy">
    <div class="row-meta mono">
      <Chip kind="id" number={session.number} postKind={session.kind} tone={tone} />
      <span>
        {session.kind === "roll" ? `· Roll${session.meta[0] ? ` · ${session.meta[0]}` : ""}` : (
          <>· {session.kind === "tape" ? "Tape" : "Session"} · Written{" "}
            <time datetime={session.date}>{formatWritten(session.date, true)}</time></>
        )}
      </span>
    </div>
    <h2>{session.title}</h2>
    <p>{session.subtitle}</p>
  </div>
  <div class="row-read mono">
    {session.kind === "roll" ? <Chip kind="frames" frames={session.frameCount} /> : <Chip minutes={session.readTime} />}
    <span>{session.kind === "roll" ? "view →" : "read →"}</span>
  </div>
</a>
<style>
  .row-cover--roll {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 2px;
    padding: 2px;
    background: var(--ink);
  }
  .row-cover--roll :global(.zc-cover) {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }
  .session-row {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr) auto;
    gap: 20px;
    padding: 20px;
    align-items: start;
    border: 1px solid var(--ink);
    background: color-mix(in oklab, var(--post-tone) 42%, var(--paper));
    transition:
      transform 150ms,
      box-shadow 150ms;
  }
  .session-row[hidden] {
    display: none;
  }
  .session-row:hover {
    transform: translate(-3px, -3px);
    box-shadow: 5px 5px 0 var(--ink);
  }
  .row-cover {
    width: 112px;
    height: 72px;
  }
  .row-cover :global(canvas) {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }
  .row-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    line-height: 1.6;
    margin-bottom: 10px;
  }
  h2 {
    font-size: 26px;
    line-height: 1.12;
    letter-spacing: -0.035em;
    font-weight: 500;
    margin: 0 0 8px;
  }
  p {
    font-size: 15px;
    line-height: 1.5;
    color: var(--mute);
    margin: 0;
  }
  .row-read {
    display: flex;
    flex-direction: column;
    align-items: end;
    gap: 18px;
    white-space: nowrap;
  }
  @media (max-width: 924px) {
    .session-row {
      grid-template-columns: 88px minmax(0, 1fr);
      gap: 16px;
    }
    .row-cover {
      width: 88px;
      height: 68px;
    }
    .row-read {
      grid-column: 2;
      flex-direction: row;
      justify-content: space-between;
    }
  }
  @media (max-width: 720px) {
    .session-row {
      padding: 14px;
      gap: 12px;
      grid-template-columns: 72px minmax(0, 1fr);
    }
    .row-cover {
      width: 72px;
      height: 72px;
    }
    h2 {
      font-size: 24px;
    }
    .row-meta {
      font-size: 9px;
      gap: 4px;
    }
    p {
      font-size: 14px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .session-row {
      transition: none;
    }
  }
</style>
