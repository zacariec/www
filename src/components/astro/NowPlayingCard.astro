---
import Cover from "./Cover.astro";
import { playedAgo, trackProgress, trackTime } from "@/lib/now-playing-display";
import type { NowPlayingData } from "@/lib/schemas/spotify";
import "@/styles/now-playing.css";

interface Props {
  state: NowPlayingData | null;
  toneStyle?: string;
}
const { state, toneStyle } = Astro.props;
const progress = state ? trackProgress(state) : 0;
const percent = state?.durationMs ? (progress / state.durationMs) * 100 : 0;
---

<a
  id="now-playing"
  class="np-card"
  href={state?.url}
  target="_blank"
  rel="noopener noreferrer"
  data-now-playing
  data-np-link
  data-state={JSON.stringify(state)}
  data-playing={String(state?.playing ?? false)}
  style={toneStyle}
  hidden={!state}
>
  <div class="np-card__bar">
    <span class="np-card__status">
      <span class="np-bars" aria-hidden="true">
        {[0, 1, 2, 3].map(() => (
          <i></i>
        ))}
      </span>
      <span data-np-status>{state?.playing ? "Now playing" : "Last played"}</span>
    </span>
    <span class="np-muted">spotify ↗</span>
  </div>
  <div class="np-card__body">
    <Cover
      seed={1}
      tone="--post-tone"
      imageUrl={state?.artUrl ?? ""}
      animated={state?.playing ?? false}
      class="np-card__art"
    />
    <div class="np-card__copy">
      <span class="np-card__track np-ellipsis" data-np-track>
        {state?.track}
      </span>
      <span class="np-muted np-ellipsis" data-np-credit>
        {state ? `${state.artist}${state.album ? ` · ${state.album}` : ""}` : ""}
      </span>
    </div>
  </div>
  <div class="np-card__progress" data-np-playing hidden={!state?.playing}>
    <span data-np-position>{trackTime(progress)}</span>
    <span
      class="np-card__meter"
      role="progressbar"
      aria-label="Track progress"
      aria-valuemin="0"
      aria-valuemax={state?.durationMs ?? 0}
      aria-valuenow={Math.floor(progress)}
      aria-valuetext={`${trackTime(progress)} of ${trackTime(state?.durationMs ?? 0)}`}
      data-np-meter
    >
      <span style={`width:${percent}%`} data-np-fill></span>
    </span>
    <span data-np-duration>{trackTime(state?.durationMs ?? 0)}</span>
  </div>
  <div class="np-card__idle np-muted" data-np-idle hidden={state?.playing ?? false}>
    Nothing on right now · <span data-np-ago>{playedAgo(state?.playedAt ?? null)}</span>
  </div>
</a>

<script>
  import "@/scripts/now-playing";
</script>
