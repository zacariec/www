---
import "../app/globals.css";
import "../styles/cursors.css";
import type { SanitySiteConfig } from "@/lib/sanity/types";
import { getSiteConfig } from "@/lib/sanity/fetch";

interface Props {
  config?: SanitySiteConfig;
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageAlt?: string;
  ogType?: string;
  canonicalUrl?: string;
  jsonLd?: object;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
}

const {
  title,
  config: suppliedConfig,
  description: descriptionProp,
  ogImage,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogImageAlt,
  ogType = "website",
  canonicalUrl,
  jsonLd,
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
} = Astro.props;

const config = suppliedConfig ?? (await getSiteConfig());

const siteUrl = config.siteUrl ? config.siteUrl.replace(/\/$/, "") : "";
function toAbsolute(url: string | undefined): string | undefined {
  if (!url) return undefined;
  if (/^https?:\/\//i.test(url)) return url;
  if (url.startsWith("/")) return siteUrl ? `${siteUrl}${url}` : undefined;
  return siteUrl ? `${siteUrl}/${url}` : undefined;
}

const description =
  descriptionProp ?? config.siteDescription ?? "Code, systems, and unfiltered thinking.";
const siteName = config.siteName || "zcarr.dev";
const pageTitle = title ? `${title} | ${siteName}` : `${siteName} \u2014 Code, Systems & Noise`;

const absoluteCanonical =
  toAbsolute(canonicalUrl) ?? (siteUrl ? `${siteUrl}${Astro.url.pathname}` : undefined);
const absoluteOgImage = toAbsolute(ogImage);
const twitterHandle = config.twitterHandle;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link
      rel="preload"
      href="/fonts/host-grotesk-400-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="theme-color" content="#EEEAE3" />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {absoluteCanonical && <meta property="og:url" content={absoluteCanonical} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    {absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}
    {absoluteOgImage && <meta property="og:image:secure_url" content={absoluteOgImage} />}
    {absoluteOgImage && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {absoluteOgImage && <meta property="og:image:height" content={String(ogImageHeight)} />}
    {absoluteOgImage && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}

    {ogType === "article" && articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )}
    {ogType === "article" && articleModifiedTime && (
      <meta property="article:modified_time" content={articleModifiedTime} />
    )}
    {ogType === "article" && articleAuthor && (
      <meta property="article:author" content={articleAuthor} />
    )}
    {ogType === "article" && <meta property="article:section" content="Writing" />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}
    {twitterHandle && <meta name="twitter:site" content={twitterHandle} />}
    {twitterHandle && <meta name="twitter:creator" content={twitterHandle} />}

    <!-- Apple -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={siteName} />

    {absoluteCanonical && <link rel="canonical" href={absoluteCanonical} />}

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- Analytics (runs in web worker via Partytown) -->
    <script
      type="text/partytown"
      src="https://cloud.umami.is/script.js"
      data-website-id="f1446875-b105-423f-8788-cb9d5457489b"
    />
  </head>
  <body class="zc-site" id="top">
    <slot />
  </body>

  <script>
    import "@/scripts/site";
  </script>
</html>
