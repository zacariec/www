---
import "../app/globals.css";
import { ClientRouter } from "astro:transitions";
import "../styles/cursors.css";
import type { SanitySiteConfig } from "@/lib/sanity/types";
import { getSiteConfig } from "@/lib/sanity/fetch";
import { defaultOgImage, siteOrigin, type OgImage } from "@/lib/seo/og-image";
import { bootstrapPreferences, DEFAULT_PREFERENCES } from "@/lib/preferences";

interface Props {
  config?: SanitySiteConfig;
  title?: string;
  description?: string;
  ogImage?: OgImage | null;
  ogType?: string;
  canonicalUrl?: string;
  jsonLd?: object;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
  articleSection?: "Session" | "Tape";
  articleReadTime?: number;
  articleWrittenDate?: string;
  noindex?: boolean;
}

const {
  title,
  config: suppliedConfig,
  description: descriptionProp,
  ogImage,
  noindex = false,
  ogType = "website",
  canonicalUrl,
  jsonLd,
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  articleSection,
  articleReadTime,
  articleWrittenDate,
} = Astro.props;

const config = suppliedConfig ?? (await getSiteConfig());

const siteUrl = siteOrigin(config);

const description = descriptionProp ?? config.siteDescription;
const siteName = config.siteName || "zcarr.dev";
const pageTitle = title ?? `${siteName} — ${config.headline.join(" ")}`;
const absoluteCanonical = new URL(canonicalUrl ?? Astro.url.pathname, siteUrl).href;
const image = ogImage === null ? undefined : (ogImage ?? defaultOgImage(config));
const absoluteOgImage = image ? new URL(image.url, siteUrl).href : undefined;
const twitterHandle = config.twitterHandle;
---

<!doctype html>
<html
  lang="en"
  data-device-preferences
  data-tone-shift={config.toneShift}
  data-page-transition={config.pageTransition ?? "radial"}
  transition:animate="none"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <ClientRouter fallback="swap" />
    <script
      is:inline
      set:html={`(${bootstrapPreferences.toString()})(${JSON.stringify(DEFAULT_PREFERENCES)});`}
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/manifest.json" />
    <link
      rel="preload"
      href="/fonts/host-grotesk-400-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="theme-color" content="#EEEAE3" />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {absoluteCanonical && <meta property="og:url" content={absoluteCanonical} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    {absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}
    {absoluteOgImage && <meta property="og:image:secure_url" content={absoluteOgImage} />}
    {image && <meta property="og:image:width" content={String(image.width)} />}
    {image && <meta property="og:image:height" content={String(image.height)} />}
    {image && <meta property="og:image:type" content={image.type} />}
    {image && <meta property="og:image:alt" content={image.alt} />}

    {ogType === "article" && articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )}
    {ogType === "article" && articleModifiedTime && (
      <meta property="article:modified_time" content={articleModifiedTime} />
    )}
    {ogType === "article" && articleAuthor && (
      <meta property="article:author" content={articleAuthor} />
    )}
    {ogType === "article" && articleSection && (
      <meta property="article:section" content={articleSection} />
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}
    {image && <meta name="twitter:image:alt" content={image.alt} />}
    {ogType === "article" && articleReadTime !== undefined && (
      <>
        <meta name="twitter:label1" content="Read" />
        <meta name="twitter:data1" content={`${articleReadTime} min`} />
      </>
    )}
    {ogType === "article" && articleWrittenDate && (
      <>
        <meta name="twitter:label2" content="Written" />
        <meta name="twitter:data2" content={articleWrittenDate} />
      </>
    )}
    {twitterHandle && <meta name="twitter:site" content={twitterHandle} />}
    {twitterHandle && <meta name="twitter:creator" content={twitterHandle} />}

    <!-- Apple -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={siteName} />

    {absoluteCanonical && <link rel="canonical" href={absoluteCanonical} />}

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- Analytics (runs in web worker via Partytown) -->
    <script
      type="text/partytown"
      src="https://cloud.umami.is/script.js"
      data-website-id="f1446875-b105-423f-8788-cb9d5457489b"
    />
  </head>
  <body class="zc-site" id="top">
    <slot />
  </body>

  <script>
    import "@/scripts/site";
  </script>
</html>
