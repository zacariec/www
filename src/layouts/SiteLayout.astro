---
import BaseLayout from "./BaseLayout.astro";
import TopBar from "@/components/astro/TopBar.astro";
import IndexTool from "@/components/astro/IndexTool.astro";
import NavPill from "@/components/astro/NavPill.astro";
import BottomTabs from "@/components/astro/BottomTabs.astro";
import EndSection from "@/components/astro/EndSection.astro";
import { getAllSessions, getAllTimelineEntries, getSiteConfig } from "@/lib/sanity/fetch";
import type { SanitySessionTape, SanityTimelineEntry, SanitySiteConfig } from "@/lib/sanity/types";
interface Props {
  config?: SanitySiteConfig;
  sessions?: SanitySessionTape[];
  timeline?: SanityTimelineEntry[];
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageAlt?: string;
  ogType?: string;
  canonicalUrl?: string;
  jsonLd?: object;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
}
const {
  config: givenConfig,
  sessions: givenSessions,
  timeline: givenTimeline,
  ...metadata
} = Astro.props;
const [config, sessions, timeline] = await Promise.all([
  givenConfig ?? getSiteConfig(),
  givenSessions ?? getAllSessions(),
  givenTimeline ?? getAllTimelineEntries(),
]);
const sessionCount = sessions.length;
const timelineCount = sessions.length + timeline.length;
---

<BaseLayout {...metadata} config={config}>
  <a class="skip-link mono" href="#content">
    Skip to content
  </a>
  <TopBar config={config} latest={sessions[0]} />
  <div class="page-flow">
    <IndexTool sessionCount={sessionCount} timelineCount={timelineCount} />
    <main id="content">
      <slot />
    </main>
    <EndSection config={config} />
    <NavPill sessionCount={sessionCount} timelineCount={timelineCount} socials={config.socials} />
  </div>
  <BottomTabs />
</BaseLayout>
<style>
  .page-flow {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
  }
  main {
    min-width: 0;
  }
  .skip-link {
    position: absolute;
    left: 16px;
    top: 8px;
    transform: translateY(-150%);
    padding: 12px;
    background: var(--pink);
    color: var(--ink);
    z-index: 100;
  }
  .skip-link:focus {
    transform: none;
  }
</style>
