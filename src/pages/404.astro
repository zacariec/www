---
import SiteLayout from "../layouts/SiteLayout.astro";
Astro.response.status = 404;
---

<SiteLayout title="Not Found">
  <section class="not-found zc-container">
    <h1 class="zc-hero-title">404</h1>
    <p>Page not found</p>
    <a class="mono" href="/">
      ← Back to home
    </a>
  </section>
</SiteLayout>
<style>
  .not-found {
    padding-top: 260px;
    padding-bottom: 150px;
  }
  .not-found p {
    margin: 28px 0;
    color: var(--mute);
  }
  .not-found a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  @media (max-width: 720px) {
    .not-found {
      padding-top: 100px;
      padding-bottom: 100px;
    }
  }
</style>
