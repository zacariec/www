---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getSiteConfig } from "@/lib/sanity/fetch";
import { generatedOgImage } from "@/lib/seo/og-image";
const config = await getSiteConfig();
Astro.response.status = 404;
---

<SiteLayout
  config={config}
  title={`Not found — ${config.siteName}`}
  description="Page not found"
  canonicalUrl="/404"
  noindex
  ogImage={generatedOgImage(
    "404",
    "404 — Page not found. Navigation back to zcarr.dev, sessions, and timeline.",
  )}
>
  <section class="not-found zc-container">
    <h1 class="zc-hero-title">404</h1>
    <p>Page not found</p>
    <a class="mono" href="/">
      ← Back to home
    </a>
  </section>
</SiteLayout>
<style>
  .not-found {
    padding-top: 260px;
    padding-bottom: 150px;
  }
  .not-found p {
    margin: 28px 0;
    color: var(--mute);
  }
  .not-found a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  @media (max-width: 720px) {
    .not-found {
      padding-top: 100px;
      padding-bottom: 100px;
    }
  }
</style>
