---
import { VisualEditing } from "@sanity/astro/visual-editing";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import SessionTapeContent from "@/components/astro/SessionTapeContent.astro";
import {
  getAllSessions,
  getAllTimelineEntries,
  getSessionBySlug,
  getSiteConfig,
} from "@/lib/sanity/fetch";
import { isPreviewRequest } from "@/lib/sanity/preview";
import PreviewLinks from "@/sanity/PreviewLinks.astro";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
const { slug } = Astro.params;
if (!(await isPreviewRequest(Astro.cookies))) {
  return new Response("Open this draft from Studio Presentation to authorize preview.", {
    status: 401,
    headers: { "Cache-Control": "no-store" },
  });
}
const [session, sessions, timeline, config] = await Promise.all([
  getSessionBySlug(slug!, { preview: true }),
  getAllSessions({ preview: true }),
  getAllTimelineEntries({ preview: true }),
  getSiteConfig({ preview: true }),
]);
if (!session) return new Response("Draft not found", { status: 404 });
---

<SiteLayout
  config={config}
  sessions={sessions}
  timeline={timeline}
  canonicalUrl={`/sessions/${slug}`}
  description={session.subtitle || session.excerpt || session.title}
  ogType="article"
  title={`[Preview] ${session.title}`}
>
  <SessionTapeContent session={session} sessions={sessions} config={config} />
  <VisualEditing enabled />
  <PreviewLinks />
</SiteLayout>
