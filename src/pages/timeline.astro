---
import SiteLayout from "../layouts/SiteLayout.astro";
import PageHero from "@/components/astro/PageHero.astro";
import TimelineItem from "@/components/astro/TimelineItem.astro";
import { getAllSessions, getAllTimelineEntries, getSiteConfig } from "@/lib/sanity/fetch";
import { resolveTone } from "@/lib/session";
import { timelineJsonLd } from "@/lib/seo/jsonld";
import { pickOgImage } from "@/lib/seo/og-image";
const [sessions, timeline, config] = await Promise.all([
  getAllSessions(),
  getAllTimelineEntries(),
  getSiteConfig(),
]);
const entries = [
  ...sessions.map((session) => ({
    kind: "session" as const,
    date: session.date,
    id: session._id,
    session,
  })),
  ...timeline.map((thought) => ({
    kind: "thought" as const,
    date: thought.date,
    id: thought._id,
    thought,
  })),
].sort((a, b) => b.date.localeCompare(a.date) || a.id.localeCompare(b.id));
const first = entries.at(-1)?.date.slice(0, 4);
const last = entries[0]?.date.slice(0, 4);
const eyebrow = first ? `[03] Log · ${first} → ${last}` : "[03] Log";
const params = new URLSearchParams(Astro.url.search);
params.delete("tone");
const og = pickOgImage(undefined, config);
---

<SiteLayout
  config={config}
  sessions={sessions}
  timeline={timeline}
  canonicalUrl="/timeline"
  title="Timeline"
  description="Sessions and thoughts, in the order they happened."
  jsonLd={timelineJsonLd(config)}
  ogImage={og?.url}
  ogImageAlt={og?.alt}
  ogImageHeight={og?.height}
  ogImageWidth={og?.width}
>
  <PageHero
    title="Timeline."
    eyebrow={eyebrow}
    description="Sessions and thoughts, in the order they happened."
    sessions={sessions}
    tone="sage"
  />
  <div class="timeline-list zc-container">
    {entries.map((entry) =>
      entry.kind === "session" ? (
        <TimelineItem
          session={entry.session}
          tone={resolveTone(
            entry.session.number,
            config.toneShift,
            params,
            entry.session.toneOverride,
          )}
        />
      ) : (
        <TimelineItem thought={entry.thought} />
      ),
    )}
  </div>
</SiteLayout>
<style>
  .timeline-list {
    position: relative;
    z-index: 2;
    padding-bottom: 140px;
  }
  @media (max-width: 720px) {
    .timeline-list {
      padding-bottom: 100px;
    }
  }
</style>
