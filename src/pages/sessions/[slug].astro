---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SessionTapeContent from "@/components/astro/SessionTapeContent.astro";
import { getSessionBySlug, getAllSessions, getSiteConfig } from "@/lib/sanity/fetch";
import { sessionTapeJsonLd } from "@/lib/seo/jsonld";
import { pickOgImage } from "@/lib/seo/og-image";
const { slug } = Astro.params;
const [session, sessions, config] = await Promise.all([
  getSessionBySlug(slug!),
  getAllSessions(),
  getSiteConfig(),
]);
if (!session) return Astro.redirect("/404");
const description = session.subtitle || session.excerpt;
const og = pickOgImage(session.featuredImage?.url, config);
const jsonLd = sessionTapeJsonLd(session, config, { ogImageUrl: og?.url });
---

<SiteLayout
  config={config}
  sessions={sessions}
  articleAuthor={config.author}
  articleModifiedTime={session.dateModified ?? session.date}
  articlePublishedTime={session.date}
  canonicalUrl={`/sessions/${slug}`}
  description={description}
  jsonLd={jsonLd}
  ogImage={og?.url}
  ogImageAlt={session.featuredImage?.alt ?? session.title}
  ogImageHeight={og?.height}
  ogImageWidth={og?.width}
  ogType="article"
  title={session.title}
>
  <SessionTapeContent session={session} sessions={sessions} config={config} />
</SiteLayout>
