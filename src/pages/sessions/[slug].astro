---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SessionTapeContent from "@/components/astro/SessionTapeContent.astro";
import { getSessionBySlug, getAllSessions, getSiteConfig } from "@/lib/sanity/fetch";
import { sessionTapeJsonLd } from "@/lib/seo/jsonld";
import { sessionOgImage } from "@/lib/seo/og-image";
import { sessionId } from "@/lib/session";
const { slug } = Astro.params;
const [session, sessions, config] = await Promise.all([
  getSessionBySlug(slug!),
  getAllSessions(),
  getSiteConfig(),
]);
if (!session) {
  Astro.locals.notFoundPath = Astro.url.pathname;
  return Astro.rewrite(new URL(`/404${Astro.url.search}`, Astro.url));
}
const description = session.subtitle || session.excerpt;
const og = sessionOgImage(session);
const jsonLd = sessionTapeJsonLd(session, config);
const writtenDate = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(session.date));
---

<SiteLayout
  config={config}
  sessions={sessions}
  articleAuthor={config.author}
  articleModifiedTime={session.dateModified ?? session.date}
  articlePublishedTime={session.date}
  articleSection={session.kind === "tape" ? "Tape" : "Session"}
  articleReadTime={session.readTime}
  articleWrittenDate={writtenDate}
  canonicalUrl={`/sessions/${slug}`}
  description={description}
  jsonLd={jsonLd}
  ogImage={og}
  ogType="article"
  title={`${session.title} — ${sessionId(session.number)} · ${config.siteName}`}
>
  <SessionTapeContent session={session} sessions={sessions} config={config} />
</SiteLayout>
