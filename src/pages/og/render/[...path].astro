---
import OgImage from "@/components/astro/OgImage.astro";
import { getAllSessions, getAllTimelineEntries, getSiteConfig } from "@/lib/sanity/fetch";

export const prerender = false;

const path = Astro.params.path ?? "";
const pages = ["default", "sessions", "timeline", "about", "404"] as const;
type Page = (typeof pages)[number];
const parts = path.split("/");
const isSession = parts.length === 2 && parts[0] === "sessions" && parts[1] !== "";
const headers = {
  "Cache-Control": "no-store",
  "X-Robots-Tag": "noindex, nofollow",
};

if (!pages.includes(path as Page) && !isSession) {
  return new Response("Not found", { status: 404, headers });
}

const [sessions, timeline, config] = await Promise.all([
  getAllSessions(),
  path === "timeline" ? getAllTimelineEntries() : Promise.resolve([]),
  getSiteConfig(),
]);
const session = isSession ? sessions.find((entry) => entry.slug === parts[1]) : undefined;
if (isSession && !session) {
  return new Response("Not found", { status: 404, headers });
}
for (const [name, value] of Object.entries(headers)) Astro.response.headers.set(name, value);
const kind = session ? session.kind : (path as Page);
---

<OgImage kind={kind} config={config} sessions={sessions} timeline={timeline} session={session} />
