---
export const prerender = false;
import SiteLayout from "../layouts/SiteLayout.astro";
import { PreferencesPanel } from "@/components/organisms/preferences-panel";
import { getSiteConfig } from "@/lib/sanity/fetch";
const config = await getSiteConfig();
---

<SiteLayout config={config} title={`Preferences — ${config.siteName}`} noindex>
  <PreferencesPanel client:only="react" />
</SiteLayout>
