---
export const prerender = false;
import SiteLayout from "../layouts/SiteLayout.astro";
import Window from "@/components/astro/Window.astro";
import { getSiteConfig } from "@/lib/sanity/fetch";
const config = await getSiteConfig();
const success = Astro.url.searchParams.get("success") === "true";
const error = Astro.url.searchParams.get("error");
---

<SiteLayout config={config} title={`Unsubscribe — ${config.siteName}`} noindex>
  <div class="utility-page zc-container">
    <a class="mono" href="/">
      ← Home
    </a>
    <Window title="Newsletter">
      <div class="utility-copy">
        <h1>{success ? "Done" : error === "expired" ? "Link expired" : "Unable to unsubscribe"}</h1>
        <p>
          {success
            ? "You've been unsubscribed. No more emails."
            : error === "expired"
              ? "This unsubscribe link has expired. Sign in to manage your preferences."
              : "Something went wrong. Sign in to manage your preferences directly."}
        </p>
        <a class="mono" href="/preferences">
          Manage preferences →
        </a>
      </div>
    </Window>
  </div>
</SiteLayout>
<style>
  .utility-page {
    max-width: 760px;
    padding-top: 260px;
    padding-bottom: 140px;
  }
  .utility-page > a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-bottom: 24px;
  }
  .utility-copy {
    padding: 28px;
  }
  .utility-copy h1 {
    font-size: 36px;
    margin: 0 0 20px;
  }
  .utility-copy p {
    color: var(--mute);
    margin-bottom: 24px;
  }
  .utility-copy a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  @media (max-width: 720px) {
    .utility-page {
      padding-top: 64px;
      padding-bottom: 100px;
    }
  }
</style>
